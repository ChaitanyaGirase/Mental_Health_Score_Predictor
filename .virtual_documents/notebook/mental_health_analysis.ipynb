# Country Grouping 

# The 'Country' column contains many unique categories, which can create too many categories during machine learning preprocessing. 
# To reduce the number of categories, the 10 most frequent contries were kept as separate categories and all remaining countries were grouped into 'Other'. 
# A new feature called 'grouped_country' was created for this purpose. 


top_countries = df['Country'].value_counts().index[:10].tolist()


def group_countries(country): 
    if country in top_countries: 
        return country
    else: 
        return 'Other'


df['grouped_country'] = df['Country'].apply(group_countries)


df['grouped_country'].value_counts()





# Before preprocessing the categorical feature, we decide how each categorical feature should be encoded. 

# 'Stress_Level' -> Ordinal encoding beacause the categories have meaningful educational order: Low < Medium < High < Very High. 

# 'Academic_Level' -> ordinal encoding beacause the categories have a meaningful educational order: High School < Undergraduate < Graduate. 

# 'Gender', 'Most_Used_Platform', 'Purpose_of_Use', 'grouped_countries' -> One-Hot encoding beacause the categories have no natural order.





from sklearn.model_selection import train_test_split
numeric_cols = ['Age', 'Avg_Daily_Usage_Hours', 'Daily_Unlocks', 'Study_Hours', 'Physical_Activity_Hours', 'Sleep_Hours_Per_Night']
ordinal_col = ['Stress_Level', 'Academic_Level']
nominal_cols = ['Gender', 'Most_Used_Platform', 'Purpose_Of_Use', 'grouped_country']

feature_col = numeric_cols + ordinal_col + nominal_cols
X = df[feature_col]
y = df['Mental_Health_Score']

X_train, X_test, y_train, y_test = train_test_split(X, y, test_size= 0.30, random_state=42)





from sklearn.pipeline import Pipeline
from sklearn.preprocessing import  StandardScaler, OrdinalEncoder, OneHotEncoder
from sklearn.compose import ColumnTransformer

# 1. Numeric Features 
numeric_pipeline = Pipeline(steps=[
    ('scale', StandardScaler())
])

# 2. Ordinal 
ordinal_pipeline = Pipeline(steps=[
    ('encode', OrdinalEncoder(categories=[
        ["Low", "Medium", "High", "Very High"],
        ["High School", "Undergraduate", "Graduate"]
    ]))
])

# 3. Nominal Features 
nominal_pipeline = Pipeline(steps=[
    ('encode', OneHotEncoder(handle_unknown='ignore'))
])


preprocessor = ColumnTransformer(transformers=[
    ("num_pipeline", numeric_pipeline, numeric_cols), 
    ("Ordinal", ordinal_pipeline, ordinal_col), 
    ("Normal", nominal_pipeline, nominal_cols)
])





# Linear Regression 
from sklearn.linear_model import LinearRegression
from sklearn.metrics import r2_score, mean_absolute_error, mean_squared_error

lr_pipeline = Pipeline(steps=[
    ('preprocessor', preprocessor), 
    ('regressor', LinearRegression())
])

lr_pipeline.fit(X_train, y_train)
lr_preds  = lr_pipeline.predict(X_test)
lr_preds_train = lr_pipeline.predict(X_train)

lr_r2_testing = r2_score(y_test, lr_preds)
lr_r2_training = r2_score(y_train, lr_preds_train)
lr_mae = mean_absolute_error(y_test, lr_preds)
lr_rmse = mean_squared_error(y_test, lr_preds) ** 0.5

print(f'Training R2 {lr_r2_training}')
print(f'Testing R2 {lr_r2_testing}')
print(f'MAE {lr_mae}')
print(f'RMSE {lr_rmse}')


# Observation  

# The Linear Regression model achieved a testing R2 of 0.7403. 

# The MAE is 0.5363, meaning that the model's predictions differ from the actual mental health score by about 0.54 points on average. 
# The RMSE is 0.7323, which is higher than MAE beacause RMSE gives more weight to larger prediction errors. 
# The training R2 (0.7248) and testing R2 (0.7403) are close, showing similar performance on both datasets. 


# Random Forest 
from sklearn.ensemble import RandomForestRegressor

rf_pipeline = Pipeline(steps=[
    ('preprocessor', preprocessor), 
    ('random forest', RandomForestRegressor(random_state=42))
])

rf_pipeline.fit(X_train, y_train)
rf_preds_test  = rf_pipeline.predict(X_test)
rf_preds_train = rf_pipeline.predict(X_train)

rf_r2_testing = r2_score(y_test, rf_preds_test)
rf_r2_training = r2_score(y_train, rf_preds_train)
rf_mae         = mean_absolute_error(y_test, rf_preds_test)
rf_rmse        = mean_squared_error(y_test, rf_preds_test) ** 0.5

print(f'testing R2: {rf_r2_testing}')
print(f'training R2: {rf_r2_training}')
print(F'MAE : {rf_mae}')
print(f'RMSE : {rf_rmse}')


# Observation 

# The random forest model achieved a testing R2 of 0.8763, which is higher than the linear regression testing R2 of 0.7403. 

# The random forest model achieved lower MAE and RMSE, indicating smaller prediction errors on the test data. 

# However, the training R2 is 0.9808 while the testing R2 is 0.8763. This difference suggest that the random forest model may be overfitting the training data. 

# Therefore, hyperparameter tuning will be performed to try to reduce overfitting and improve the model generalization.  


# Hyperparameter Tuning 
from sklearn.model_selection import RandomizedSearchCV

param_grid = {
    'random forest__n_estimators'      :[100,200,300],
    'random forest__max_depth'         : [5,10,15],
    'random forest__min_samples_split'  : [2,5,100],
    'random forest__min_samples_leaf'   : [1,2,4]
}

random_search = RandomizedSearchCV(
    estimator= rf_pipeline, 
    param_distributions= param_grid, 
    n_iter= 15, 
    cv= 5, 
    scoring= 'r2',
    random_state=42, 
    n_jobs= -1
)
random_search.fit(X_train, y_train)


random_search.best_params_


rf_best_pipeline = random_search.best_estimator_
rf_best_preds    = rf_best_pipeline.predict(X_test)

print(f'Testing R2 of randomforest: {r2_score(y_test, rf_best_preds)}')
print(f'MAE of randomforest: {mean_absolute_error(y_test, rf_best_preds)}')
print(f'RMSE of randomforest: {mean_squared_error(y_test, rf_best_preds) ** 0.5}')


# Observation 

# Hyperparameter tuning was performed using RandomizedSerachCV with 5-fold cross-validation. 

# The tuned random forest achieved a testing R2 of 0.8635, MAE of 0.3707, and RMSE of 0.4896. 

# These results were slightly worse than the original random forest, which achieved a testing R2 of 0.8763, MAE of 0.3487, and RMSE of 0.4662. 

# Therefore, the tuning experiment did not improve the performance on the held-out test set. 






